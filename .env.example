# ===== إلزامي =====
# قاعدة Turso (libSQL عبر HTTP — متوافقة مع Vercel، بلا ملفات محلية)
# إنشئ قاعدة مجانية: turso db create <name>
# ثم: turso db show <name> --url   و   turso db tokens create <name>
TURSO_DATABASE_URL=libsql://<db-name>-<org>.turso.io
TURSO_AUTH_TOKEN=<Turso token بصلاحيات كتابة>

# خدمة دمج الفيديو Video Merger API v2 (بلا مفاتيح) — ضع رابط خدمتك
MERGER_API_BASE=https://<merger-service>

# ===== اختياري =====
# إن ضُبط يُطلب Authorization: Bearer <token> على /mcp
MCP_ACCESS_TOKEN=
# تجاوز أسماء الموديلات إن لزم
KIE_IMAGE_MODEL=
KIE_VIDEO_MODEL=
COMETAPI_IMAGE_MODEL=
COMETAPI_VIDEO_MODEL=
